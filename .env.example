# Copy to .env — `make up` reads this file. Values below work out of the box.

# Postgres (source OLTP — simulates the coffee chain's POS database)
POSTGRES_USER=coffee
POSTGRES_PASSWORD=coffee
POSTGRES_DB=coffee_pos
POSTGRES_PORT=5432

# MinIO (S3-compatible data lake)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
LAKE_BUCKET=lake

# Kafka stack (PROFILE=streaming)
KAFKA_PORT=9092
SCHEMA_REGISTRY_PORT=8081
KAFKA_UI_PORT=8080
DEBEZIUM_PORT=8083

# Airflow (PROFILE=all)
AIRFLOW_PORT=8082
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Marquez (PROFILE=all)
# Host port 5050 vì macOS dùng 5000 cho AirPlay Receiver (trong network vẫn là marquez-api:5000)
MARQUEZ_API_PORT=5050
MARQUEZ_WEB_PORT=3000

# Trino (PROFILE=analytics)
TRINO_PORT=8090

# Spark
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8085

# Jupyter (default profile)
JUPYTER_PORT=8888

# Optional AWS (video #09, #22). Leave empty to use MinIO only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
